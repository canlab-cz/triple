+QString AiAssistantWindow::apiKey() const
+{
+    if (!sessionKey.isEmpty()) return sessionKey;
+    QString k = QSettings().value("AiAssistant/apiKey").toString();
+    if (!k.isEmpty()) return k;
+    return qEnvironmentVariable("ANTHROPIC_API_KEY");
+}
